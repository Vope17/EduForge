# Copy to .env and edit. docker compose reads .env automatically.

# Host port EduForge listens on (bound to 127.0.0.1).
EDUFORGE_PORT=8081

# Comma-separated browser URLs (scheme://host[:port]) allowed to open EduForge.
# Each URL's host is also an allowed Host header; anything else gets 403 invalid_host / invalid_origin.
# Setting this replaces the defaults entirely, so keep:
#   http://127.0.0.1:8080  - the container healthcheck
#   http://127.0.0.1:8081, http://localhost:8081 - local access through EDUFORGE_PORT
# and add the URL you reach it by through a proxy or another container, e.g. https://eduforge.example.com
EDUFORGE_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:8081,http://localhost:8081

# Pages allowed to show EduForge in a frame (space-separated), e.g. the iLearn portal. Empty forbids framing.
EDUFORGE_FRAME_ANCESTORS=http://127.0.0.1:8090 http://localhost:8090

# 1 = read-only showcase: visitors can browse but nothing can be changed or generated.
# Set 0 while you prepare content yourself, then 1 before sharing the URL.
EDUFORGE_READONLY=0
