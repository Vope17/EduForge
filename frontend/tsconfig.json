{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
